PORT=3000
STORAGE_DIR=./storage
MAX_UPLOAD_GB=4

# 0 = never automatically delete stored videos.
# For public hosting, use object storage and a proper retention policy.
FILE_TTL_HOURS=24

# Required when deployed behind a proxy and you want absolute share URLs:
# PUBLIC_BASE_URL=https://video.example.com

# 120 FPS interpolation encoder settings:
X264_PRESET=slow
X264_CRF=10
